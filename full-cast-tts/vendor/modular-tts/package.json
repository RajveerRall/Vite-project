{
  "name": "modular-tts",
  "version": "0.1.0",
  "description": "A modular text-to-speech pipeline with support for multiple LLMs, parsers, and TTS providers",
  "main": "dist/api.js",
  "module": "dist/api.js",
  "types": "dist/api.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "prepublishOnly": "npm run build",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "tts",
    "text-to-speech",
    "ai",
    "llm",
    "openai",
    "gemini",
    "cartesia",
    "voice",
    "audio",
    "dialogue",
    "narration"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cartesia/cartesia-js": "^2.2.5",
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.2.1",
    "openai": "^5.11.0",
    "pino": "^9.7.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "express": "^5.1.0"
  },
  "optionalDependencies": {
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jest": "^30.0.5",
    "multer": "^2.0.2",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "zod-to-json-schema": "^3.24.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/modular-tts.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/modular-tts/issues"
  },
  "homepage": "https://github.com/yourusername/modular-tts#readme"
