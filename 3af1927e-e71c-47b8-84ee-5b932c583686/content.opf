<package xmlns="http://www.idpf.org/2007/opf" unique-identifier="uuid_id" version="2.0">
  <metadata xmlns:calibre="http://calibre.kovidgoyal.net/2009/metadata" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:opf="http://www.idpf.org/2007/opf" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <dc:title>Fae Hunter (Tangled Fae Book 1)</dc:title>
    <dc:date>2020-01-06T16:00:00+00:00</dc:date>
    <dc:contributor opf:role="bkp">calibre (3.48.0) [https://calibre-ebook.com]</dc:contributor>
    <dc:identifier opf:scheme="MOBI-ASIN">B07XLPZTFR</dc:identifier>
    <dc:identifier id="uuid_id" opf:scheme="uuid">d16614e5-68b8-45ef-806d-a11f746cbffe</dc:identifier>
    <dc:identifier opf:scheme="calibre">d16614e5-68b8-45ef-806d-a11f746cbffe</dc:identifier>
    <dc:publisher>Sarah K. L. Wilson</dc:publisher>
    <dc:description>&lt;p&gt;Everyone loves a good faerie story right?&lt;/p&gt;&lt;p&gt;Wrong.&lt;/p&gt;&lt;p&gt;I'm Allie Hunter and I'm going to end every faerie story ever told.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Why?&amp;nbsp;&lt;/p&gt;&lt;p&gt;They snatched my sister and now they're threatening every person in our little village.&amp;nbsp;&lt;/p&gt;&lt;p&gt;How?&amp;nbsp;&lt;/p&gt;&lt;p&gt;Well, that's a good question. And when I figure it out, I'll let you know.&lt;/p&gt;&lt;p&gt;Until then, they'd better watch out. Because no amount of glamor, seduction, power or magic is going to stop me from purging the earth of their kind.&lt;/p&gt;&lt;p&gt;I'm Allie Hunter, and I hunt Fae.&lt;/p&gt;&lt;p&gt;Who's with me?&lt;/p&gt;</dc:description>
    <dc:creator opf:file-as="Wilson, Sarah K. L." opf:role="aut">Sarah K. L. Wilson</dc:creator>
    <dc:language>en</dc:language>
