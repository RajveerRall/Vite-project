# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Supabase Configuration (replaces Books API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# TTS API Configuration (disabled for mobile compatibility)
# VITE_TTS_API_URL=http://localhost:8080

# Full Cast TTS Server
VITE_FULL_CAST_TTS_URL=http://localhost:4001

# Optional: Analytics
VITE_ANALYTICS_ENABLED=true

# Strapi CMS Configuration (for Static Site Generation)
VITE_STRAPI_API_URL=http://localhost:1337
VITE_STRAPI_API_TOKEN=your-strapi-api-token-here 

# Gemini OCR
VITE_GEMINI_API_KEY=your-gemini-api-key

# Google Identity Services (official web button)
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# DodoPayments (Usage-Based Billing)
VITE_DODO_API_KEY=your-dodo-api-key
VITE_DODO_BASE_URL=https://test.dodopayments.com