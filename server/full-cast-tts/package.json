{
  "name": "full-cast-tts-service",
  "private": true,
  "type": "commonjs",
  "main": "server.cjs",
  "scripts": {
    "start": "node server.cjs",
    "start:portable": "node portable-launcher.js",
    "sync-vendor": "bash sync-vendor.sh",
    "postinstall": "npm run sync-vendor",
    "build:portable": "pkg . --targets node18-win-x64 --output dist/full-cast-tts.exe"
  },
  "pkg": {
    "scripts": [
      "server.cjs",
      "portable-launcher.js"
    ],
    "assets": [
      "vendor/**/*",
      "node_modules/@your-scope/modular-tts/**/*",
      "node_modules/axios/dist/**/*",
      "node_modules/axios/lib/**/*",
      "node_modules/axios/index.js",
      "node_modules/axios/package.json",
      "node_modules/**/*.node",
      "node_modules/**/*.json"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "@cartesia/cartesia-js": "^2.2.5",
    "@google/genai": "^1.27.0",
    "@google/generative-ai": "^0.24.1",
    "@your-scope/modular-tts": "file:your-scope-modular-tts-2.0.0.tgz",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "mime": "^4.1.0",
    "openai": "^5.11.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.1",
    "zod": "^3.25.8",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
